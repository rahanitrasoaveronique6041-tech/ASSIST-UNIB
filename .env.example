EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend-only settings. Never expose these with the EXPO_PUBLIC_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
APP_ENV=production
ENABLE_DEMO_KNOWLEDGE=false
# Optional comma-separated list used to recognize programme names in questions.
KNOWN_FILIERES=
# Only needed by the backend to delete user accounts through Supabase Admin API.
# Never use an EXPO_PUBLIC_ prefix for this secret.
SUPABASE_SERVICE_ROLE_KEY=
